<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>1.1.0.0</Version>
    <Description>Tinker with your hotbars, such as showing them when it rains but only when you're in combat!&#10;/willobars opens the settings.</Description>
    <PackageProjectUrl>https://github.com/NeonGhostCinnamon/WillOBars</PackageProjectUrl>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="images\icon.png" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <Content Include="images\discord.png" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <!-- Nunito Black (SIL Open Font License), the font used on will-o-cinnamon.com -->
    <Content Include="Nunito-Black.ttf" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <Content Include="Nunito-OFL.txt" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>
